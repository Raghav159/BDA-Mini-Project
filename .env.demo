# =============================================================
# BDA Mini Project - DEMO Configuration (10-minute windows)
# =============================================================
# To use: cp .env.demo .env
# =============================================================

# --- Windowing (10 minutes = 600 seconds) ---
WINDOW_SIZE=600
REFRESH_INTERVAL=600

# --- Kafka ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=sales-events
KAFKA_CONSUMER_GROUP=ranking-engine-group

# --- Producer ---
PRODUCER_RATE=200
BURST_PRODUCT_ID=
BURST_MULTIPLIER=10
BURST_DURATION=120

# --- HDFS ---
HDFS_BASE_PATH=/bda-project
HADOOP_CONTAINER=bda-hadoop

# --- FastAPI ---
API_HOST=0.0.0.0
API_PORT=8000

# --- Dataset ---
DATASET_PATH=datasets/instacart
