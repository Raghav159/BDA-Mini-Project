# =============================================================
# BDA Mini Project - Configuration Template
# =============================================================
# Copy this file to .env and adjust values as needed.
#
# Two configurations are documented:
#   Development/Testing: WINDOW_SIZE=60, REFRESH_INTERVAL=60
#   Final Demo:          WINDOW_SIZE=600, REFRESH_INTERVAL=600
#
# All time values are in SECONDS.
# =============================================================

# --- Windowing ---
# How long each processing window lasts (seconds)
WINDOW_SIZE=60
# How often the ranking refreshes (seconds) — should equal WINDOW_SIZE
REFRESH_INTERVAL=60

# --- Kafka ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=sales-events
KAFKA_CONSUMER_GROUP=ranking-engine-group

# --- Producer ---
# Messages per second (controls simulation speed)
# Dev: 50, Demo: 200
PRODUCER_RATE=50
# Set to a product_id to simulate a sales burst for that product
BURST_PRODUCT_ID=
# How many extra transactions per normal transaction during burst
BURST_MULTIPLIER=10
# How long the burst lasts (seconds)
BURST_DURATION=120

# --- HDFS ---
HDFS_BASE_PATH=/bda-project
HADOOP_CONTAINER=bda-hadoop

# --- FastAPI ---
API_HOST=0.0.0.0
API_PORT=8000

# --- Dataset ---
# Path to the Instacart dataset directory (relative to project root)
DATASET_PATH=datasets/instacart
